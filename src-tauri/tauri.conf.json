{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JaBot",
  "version": "0.1.0",
  "identifier": "com.jabot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "JaBot",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "publisher": "JaBot",
    "shortDescription": "Bot-crew messenger for coding harnesses",
    "homepage": "https://github.com/jabreeflor/jabot",
    "resources": ["vendor/adapters/node_modules/**/*"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "./entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5M0VDMzkzNDYyNzYyQTAKUldTZ1lpZEdrOE0rV1hOdkhkRVRUVFNhVFVuMEtKd2tuNTg2SENFc2dvVy9yeE1CVHdzOWtVVTkK",
      "endpoints": [
        "https://github.com/jabreeflor/jabot/releases/latest/download/latest.json"
      ]
    }
  }
}
